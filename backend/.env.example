PORT=5000

# Database (MongoDB local default — install via `winget install MongoDB.Server`)
MONGODB_URI=mongodb://localhost:27017/ai-learning
# Hoặc dùng mock mode (in-memory, chỉ dùng cho test auth): MONGODB_URI=mock

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Google Gemini / Gemma (free tier — https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemma-3-27b-it
